# Amadeus API Credentials (https://developers.amadeus.com)
AMADEUS_API_CLIENTID=WPISZ_TUTAJ_SWOJ_AMADEUS_CLIENT_ID
AMADEUS_API_CLIENTSECRET=WPISZ_TUTAJ_SWOJ_AMADEUS_CLIENT_SECRET

# Signing key for JWT access tokens. Must be Base64-encoded and decode to at
# least 256 bits, because the tokens are signed with HS256.
JWT_SECRET_KEY=WPISZ_TUTAJ_SWOJ_KLUCZ_JWT_W_BASE64

API_SECURITY_KEY=WPISZ_TUTAJ_SWOJ_KLUCZ_API

# Admin User Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
